+++ b/src/api/invoice-export.ts
@@ -0,0 +1,10 @@
+import { ExportClient } from "./export-client";
+import type { Invoice } from "./invoices-client";
+
+const client = new ExportClient();
+
+export async function exportInvoicesCsv(): Promise<string> {
+  const invoices = await client.getRows<Invoice[]>("/invoices");
+  const rows = invoices.map((invoice) => `${invoice.id},${invoice.userId},${invoice.totalCents}`);
+  return ["id,userId,totalCents", ...rows].join("\n");
+}
