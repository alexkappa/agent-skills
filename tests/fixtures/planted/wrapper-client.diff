+import { request } from "../lib/http";
+
+export class ExportClient {
+  getRows<T>(path: string): Promise<T> {
+    return request<T>(path);
+  }
+
+  getRow<T>(path: string, id: string): Promise<T> {
+    return request<T>(`${path}/${id}`);
+  }
+}
